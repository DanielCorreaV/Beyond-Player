<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- This is for HomeFragment's AppBarLayout. Explanations for these can be found there. -->
    <item name="home_song_recycler" type="id" />
    <item name="home_album_recycler" type="id" />
    <item name="home_artist_recycler" type="id" />
    <item name="home_genre_recycler" type="id" />
    <item name="home_playlist_recycler" type="id" />

    <!-- Style-dependent shapes and decoration (see AppStyle). Classic values live in Theme.Auxio.Base. -->
    <attr name="auxioShapeSmall" format="reference" />
    <attr name="auxioShapeLarge" format="reference" />
    <attr name="auxioShapeCover" format="reference" />
    <attr name="auxioOverlay" format="reference" />
    <attr name="auxioCoverDecor" format="reference" />
    <attr name="auxioCoverGlow" format="reference" />
    <attr name="auxioShapeSheet" format="reference" />
    <attr name="auxioBackground" format="reference|color" />
    <attr name="auxioControlsBackground" format="reference" />
    <attr name="auxioControlsPadding" format="dimension" />
    <attr name="auxioHomeCardStyle" format="reference" />
    <attr name="auxioPlaybackToggleStyle" format="reference" />
    <attr name="auxioPlaybackSkipStyle" format="reference" />
    <attr name="auxioPlaybackPlayPauseStyle" format="reference" />

    <integer name="anim_fade_enter_duration">200</integer>
    <integer name="anim_fade_exit_duration">100</integer>

    <declare-styleable name="CoverView">
        <attr name="shapeAppearance" format="reference" />
        <attr name="iconSize" format="dimension" />
        <attr name="enablePlaybackIndicator" format="boolean" />
        <attr name="enableSelectionBadge" format="boolean" />
    </declare-styleable>

    <declare-styleable name="StepperOverlay">
        <attr name="shapeAppearance" />
    </declare-styleable>

    <declare-styleable name="PlayerSwipeIndicatorOverlay">
        <attr name="shapeAppearance" />
    </declare-styleable>

    <declare-styleable name="WavySlider">
        <attr name="wavelength" format="dimension" />
        <attr name="waveAmplitude" format="dimension" />
        <attr name="waveSpeed" format="dimension" />
        <attr name="waveAmplitudeRampProgressMax" format="float" />
        <attr name="waveAmplitudeRampProgressMin" format="float" />
    </declare-styleable>

    <declare-styleable name="IntListPreference">
        <attr name="entries" format="reference" />
        <attr name="entryValues" format="reference" />
        <attr name="entryIcons" format="reference" />
        <attr name="offValue" format="reference" />
    </declare-styleable>
</resources>