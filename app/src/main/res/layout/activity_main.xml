<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/auxioBackground"
        app:defaultNavHost="true"
        app:navGraph="@navigation/outer"
        tools:layout="@layout/fragment_main" />

    <!-- Decoration of the selected style (glow, custom background image). Never takes input. -->
    <View
        android:id="@+id/style_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/auxioOverlay"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

</FrameLayout>
