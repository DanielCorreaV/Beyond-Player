<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/auxioBackground"
    android:transitionGroup="true">


    <org.oxycblt.auxio.ui.CoordinatorAppBarLayout
        android:id="@+id/home_appbar"
        style="@style/Widget.Auxio.AppBarLayout">

        <!-- Header: the toolbar is pinned on top, the card scrolls away underneath it -->
        <FrameLayout
            android:id="@+id/home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:minHeight="?attr/actionBarSize">

        <LinearLayout
            android:id="@+id/home_header_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/actionBarSize"
            android:orientation="vertical">

            <!-- Now playing card, only shown by the Neon, Vinyl and Pop styles -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_now_card"
                style="?attr/auxioHomeCardStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_small"
                android:visibility="gone"
                app:layout_scrollFlags="scroll|enterAlways">

                <!-- Large variant with a record, used by the Vinyl style -->
                <FrameLayout
                    android:id="@+id/home_now_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="176dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="-80dp">

                        <org.oxycblt.auxio.image.CoverView
                            android:id="@+id/home_now_disc"
                            style="@style/Widget.Auxio.Image.Medium"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:enablePlaybackIndicator="false"
                            app:enableSelectionBadge="false" />

                        <View
                            android:id="@+id/home_now_disc_decor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/auxioCoverDecor"
                            android:importantForAccessibility="no" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="24dp"
                        android:paddingTop="22dp"
                        android:paddingEnd="150dp"
                        android:paddingBottom="22dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_now_playing_card"
                            android:textAllCaps="true"
                            android:textAppearance="?attr/textAppearanceLabelMediumEmphasized"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/home_now_hero_song"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceTitleLargeEmphasized"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/home_now_hero_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/home_now_continue"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/lbl_hero_continue" />

                    </LinearLayout>

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/home_now_compact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_mid_medium">

                    <org.oxycblt.auxio.image.CoverView
                        android:id="@+id/home_now_cover"
                        style="@style/Widget.Auxio.Image.Medium"
                        app:enablePlaybackIndicator="false"
                        app:enableSelectionBadge="false" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_mid_medium"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_now_playing_card"
                            android:textAllCaps="true"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/home_now_song"
                            style="@style/Widget.Auxio.TextView.Item.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:textAppearance="?attr/textAppearanceTitleMediumEmphasized" />

                        <TextView
                            android:id="@+id/home_now_artist"
                            style="@style/Widget.Auxio.TextView.Item.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp" />

                    </LinearLayout>

                    <org.oxycblt.auxio.ui.RippleFixMaterialButton
                        android:id="@+id/home_now_play"
                        style="?attr/auxioPlaybackPlayPauseStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:contentDescription="@string/desc_play_pause"
                        app:icon="@drawable/sel_playing_state_24"
                        app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Neon dashboard: search, recent songs, playlists -->
            <LinearLayout
                android:id="@+id/home_neon_dash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Pop hero: shuffle the whole library -->
                <FrameLayout
                    android:id="@+id/home_pop_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pop_shadow"
                        android:importantForAccessibility="no" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/home_pop_hero_card"
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#FFD84D"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#17142B"
                        app:strokeWidth="2dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <View
                                android:id="@+id/home_pop_blob_a"
                                android:layout_width="130dp"
                                android:layout_height="130dp"
                                android:layout_gravity="end|top"
                                android:layout_marginTop="-20dp"
                                android:layout_marginEnd="-24dp"
                                android:background="@drawable/bg_pop_blob_pink"
                                android:importantForAccessibility="no" />

                            <View
                                android:id="@+id/home_pop_blob_b"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_gravity="end|top"
                                android:layout_marginTop="52dp"
                                android:layout_marginEnd="44dp"
                                android:background="@drawable/bg_pop_blob_blue"
                                android:importantForAccessibility="no"
                                android:rotation="12" />

                            <org.oxycblt.auxio.image.CoverView
                                android:id="@+id/home_pop_hero_cover"
                                android:layout_width="104dp"
                                android:layout_height="104dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="18dp"
                                android:visibility="gone"
                                app:enablePlaybackIndicator="false"
                                app:enableSelectionBadge="false" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <TextView
                                    android:id="@+id/home_pop_hero_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.08"
                                    android:text="@string/lbl_pop_hero_label"
                                    android:textColor="#17142B"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/home_pop_hero_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:maxWidth="190dp"
                                    android:text="@string/lbl_pop_hero_title"
                                    android:textColor="#17142B"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/home_pop_hero_sub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:maxWidth="190dp"
                                    android:textColor="#17142B"
                                    android:textSize="13sp"
                                    android:visibility="gone" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/home_pop_play"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/lbl_pop_hero_play"
                                    android:textColor="#FFFFFF"
                                    app:backgroundTint="#17142B" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/home_pop_hero_dots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end|bottom"
                                android:layout_marginEnd="18dp"
                                android:layout_marginBottom="10dp"
                                android:textColor="#17142B"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_search_pill"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_search_24"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/lbl_neon_search"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/home_recents_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:layout_marginBottom="@dimen/spacing_small"
                        android:text="@string/lbl_neon_recents"
                        android:textAppearance="?attr/textAppearanceTitleMediumEmphasized"
                        android:textColor="?attr/colorOnSurface" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/home_recents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/home_lists_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:layout_marginBottom="@dimen/spacing_small"
                        android:text="@string/lbl_neon_lists"
                        android:textAppearance="?attr/textAppearanceTitleMediumEmphasized"
                        android:textColor="?attr/colorOnSurface" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/home_lists"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <org.oxycblt.auxio.ui.MultiToolbar
            android:id="@+id/home_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.oxycblt.auxio.ui.AuxioToolbar
                android:id="@+id/home_normal_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll|enterAlways"
                app:menu="@menu/toolbar_home"
                app:title="@string/info_app_name" />

            <org.oxycblt.auxio.ui.AuxioToolbar
                android:id="@+id/home_selection_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:menu="@menu/toolbar_selection"
                app:navigationIcon="@drawable/ic_close_24" />

        </org.oxycblt.auxio.ui.MultiToolbar>

        </FrameLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/home_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:tabContentStart="@dimen/spacing_medium"
            app:tabGravity="start"
            app:tabMode="scrollable" />

    </org.oxycblt.auxio.ui.CoordinatorAppBarLayout>


    <FrameLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:clipToPadding="false"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/home_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            tools:layout="@layout/fragment_home_list" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_indexing_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:transitionGroup="true"
            android:visibility="invisible"
            android:layout_margin="@dimen/spacing_medium">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/home_indexing_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_tiny" />

            <ImageView
                android:id="@+id/home_indexing_error"
                android:layout_width="@dimen/size_touchable_small"
                android:layout_height="@dimen/size_touchable_small"
                android:layout_gravity="center"
                android:contentDescription="@string/err_index_failed"
                android:scaleType="centerInside"
                android:src="@drawable/ic_feature_request_24"
                app:tint="?attr/colorError"
                tools:visibility="invisible" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
