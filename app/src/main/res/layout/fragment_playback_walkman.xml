<?xml version="1.0" encoding="utf-8"?>
<!-- Pop style, tall phones: the Walkman player. Same ids as fragment_playback_panel. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_walkman_screen">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <org.oxycblt.auxio.ui.AuxioToolbar
            android:id="@+id/playback_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/toolbar_playback"
            app:navigationIcon="@drawable/ic_down_24"
            app:subtitleCentered="true"
            app:subtitleTextAppearance="?attr/textAppearanceBodySmall"
            app:title="@string/lbl_playback"
            app:titleCentered="true"
            app:titleTextAppearance="?attr/textAppearanceLabelLargeEmphasized"
            tools:subtitle="@string/lbl_all_songs" />

        <!-- Status strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_walkman_strip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_walkman_led"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="BATT / PEAK"
                android:textColor="#8FA0BC"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_walkman_chip_outline"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="DOLBY B"
                    android:textColor="#E8EDF7"
                    android:textSize="9sp"
                    android:textStyle="bold" android:layout_marginEnd="6dp" />
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_walkman_chip_yellow"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="NORM"
                    android:textColor="#101A2B"
                    android:textSize="9sp"
                    android:textStyle="bold" android:layout_marginEnd="6dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="CrO₂"
                android:textColor="#5F708C"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/playback_walkman_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_walkman_counter"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="000"
                android:textColor="#FFD84D"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- The cassette -->
        <org.oxycblt.auxio.playback.WalkmanTouchLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:id="@+id/playback_walkman_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_walkman_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="■ SIDE A  •  STEREO"
                        android:textColor="#FF5FA2"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TPS-L2 / 120µs"
                        android:textColor="#8FA0BC"
                        android:fontFamily="monospace"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Label: cover + song -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_walkman_label">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_walkman_chip_pink" android:importantForAccessibility="no" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_walkman_chip_yellow" android:importantForAccessibility="no" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_walkman_chip_cyan" android:importantForAccessibility="no" />
                    </LinearLayout>

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/playback_pager"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/playback_label_kicker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        android:text="C-60  HIGH BIAS"
                        android:textColor="#6B6252"
                        android:fontFamily="monospace"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/playback_label_brand"
                        app:layout_constraintStart_toEndOf="@+id/playback_pager"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/playback_label_brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="BEYOND"
                        android:textColor="#1B1B1D"
                        android:textSize="12sp"
                        android:textStyle="bold|italic"
                        app:layout_constraintBaseline_toBaselineOf="@+id/playback_label_kicker"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/playback_label_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textColor="#1B1B1D"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/playback_pager"
                        app:layout_constraintTop_toBottomOf="@+id/playback_label_kicker" />

                    <TextView
                        android:id="@+id/playback_label_artist"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#C0392B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/playback_pager"
                        app:layout_constraintTop_toBottomOf="@+id/playback_label_title" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toEndOf="@+id/playback_pager"
                        app:layout_constraintTop_toBottomOf="@+id/playback_label_artist">

                        <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_walkman_chip_cyan"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="STEREO"
                        android:textColor="#0E1726"
                        android:textSize="9sp"
                        android:textStyle="bold" android:layout_marginEnd="6dp" />
                        <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_walkman_chip_outline"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="NR ON"
                        android:textColor="#6B6252"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Window with the reels -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_walkman_window">

                    <ImageView
                        android:id="@+id/playback_reel_left"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_walkman_reel" />

                    <ImageView
                        android:id="@+id/playback_reel_right"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_walkman_reel" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100 – 50 – 0"
                            android:textColor="#8FA0BC"
                            android:fontFamily="monospace"
                            android:textSize="9sp" />

                        <View
                            android:layout_width="44dp"
                            android:layout_height="3dp"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="3dp"
                            android:background="@drawable/bg_walkman_chip_pink"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TAPE RUNNING"
                            android:textColor="#5F708C"
                            android:fontFamily="monospace"
                            android:textSize="7sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/playback_footer_album"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#E8EDF7"
                        android:fontFamily="monospace"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/playback_footer_artist"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="#8FA0BC"
                        android:fontFamily="monospace"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <org.oxycblt.auxio.playback.ui.stepper.StepperOverlay
                android:id="@+id/playback_walkman_seek"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:shapeAppearance="@style/ShapeAppearance.Style.R8" />
        </org.oxycblt.auxio.playback.WalkmanTouchLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- State chip + title + heart/menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/playback_info_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/playback_walkman_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_walkman_state"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="@string/lbl_walkman_playing"
                        android:textColor="#FF6A2B"
                        android:fontFamily="monospace"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/playback_song"
                        style="@style/Widget.Auxio.TextView.Primary.Compact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fallbackLineSpacing="false"
                        tools:text="Song Name" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/playback_artist"
                        style="@style/Widget.Auxio.TextView.Secondary.Marquee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="150dp"
                        tools:text="Artist Name" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" · "
                        android:textColor="#8FA0BC" />

                    <TextView
                        android:id="@+id/playback_album"
                        style="@style/Widget.Auxio.TextView.Secondary.Marquee"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Album Name" />
                </LinearLayout>
            </LinearLayout>

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/playback_favorite"
                style="@style/Widget.Auxio.Button.Playback.More"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:contentDescription="@string/desc_favorite"
                app:icon="@drawable/sel_favorite_state_24"
                app:iconTint="@color/sel_favorite_tint"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small"
                app:toggleCheckedStateOnClick="false" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/playback_more"
                style="@style/Widget.Auxio.Button.Playback.More"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_more_24"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.oxycblt.auxio.playback.ui.StyledSeekBar
                android:id="@+id/playback_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:text="TAPE POSITION"
                android:textColor="#5F708C"
                android:fontFamily="monospace"
                android:textSize="9sp" />
        </FrameLayout>

        <org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout
            android:id="@+id/playback_controls_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/auxioControlsBackground"
            android:padding="?attr/auxioControlsPadding">

            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButtonGroup
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:spacing="@dimen/spacing_small">

                <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                    android:id="@+id/playback_repeat"
                    style="?attr/auxioPlaybackToggleStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc_change_repeat"
                    app:icon="@drawable/ic_repeat_off_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium" />

                <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                    android:id="@+id/playback_skip_prev"
                    style="?attr/auxioPlaybackSkipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc_skip_prev"
                    app:icon="@drawable/ic_skip_prev_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large.Narrow" />

                <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                    android:id="@+id/playback_play_pause"
                    style="?attr/auxioPlaybackPlayPauseStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc_play_pause"
                    app:icon="@drawable/sel_playing_state_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large"
                    tools:icon="@drawable/ic_play_24" />

                <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                    android:id="@+id/playback_skip_next"
                    style="?attr/auxioPlaybackSkipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc_skip_next"
                    app:icon="@drawable/ic_skip_next_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large.Narrow" />

                <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                    android:id="@+id/playback_shuffle"
                    style="?attr/auxioPlaybackToggleStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc_shuffle"
                    app:icon="@drawable/sel_shuffle_state_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium"
                    app:tint="@color/sel_activatable_icon" />

            </org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButtonGroup>
        </org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
